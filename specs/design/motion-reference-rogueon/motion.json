  }
 },
 "pageIntro": {
  "mechanism": "data-intro-state=pending→playing→done no hero; ~3.0s total (playing@223ms, done@3213ms). Fundo começa scale 2.05 + blur(45px) + shade e relaxa; conteúdo [data-intro-reveal] translateY(14px) opacity 0 → entra. Botão 'pular' (skip) sempre disponível. Fallback CSS: animation 0s com delay 1.5s força visibilidade se o JS falhar.",
  "skip": true,
  "fallback": "conteúdo nunca fica preso invisível"
 },
