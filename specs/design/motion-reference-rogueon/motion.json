 "transitionsFromCss": [
  "transform .16s ease (press)",
  "transform .38s var(--spring) (hover lift/dock)",
  "opacity .2s + transform .38s spring (tooltip/tag)",
  "grid-template-rows .28s cubic-bezier(.3,.8,.3,1) (accordion)",
  "transform .3s var(--out) (ícone +/− do FAQ)",
  "opacity .35s ease + scale .55s cubic-bezier(.3,1.5,.5,1) (balão)",
  "opacity .08s linear + transform .8s springPeek (mascote)",
  "opacity .6s ease (fade de mídia)",
  "background/color/box-shadow .12s ease (links, hover)",
  "background .15s,color .15s (tabs)"
 ],
 "chatSequence": {
  "mechanism": "atributo data-conversation no container (idle→user→typing→reply) muda por JS; CSS só reage (opacity/scale por seletor de atributo). Disparo por IntersectionObserver threshold .45.",
  "timeline_ms": {
   "idle": 0,
   "user": 150,
   "typing": 900,
   "reply": 2000,
   "note": "medido: idle@10599, user@10750, typing@11500, reply@12599 (Δ 150/750/1100 entre estados). Loop volta a idle."
  },
  "bubble": {
   "hidden": "opacity:0;scale:.55",
   "visible": "opacity:1;scale:1",
   "transition": "opacity .35s ease, scale .55s cubic-bezier(.3,1.5,.5,1)",
   "transformOrigin": "canto da cauda (100% 100% user, 0 100% assistente)",
   "float": "bubble-float 4.6s/5.4s ease-in-out infinite, delay .6s/1.4s, reverse no 2º (usa propriedade `translate`, não transform, para não brigar com scale)"
  },
  "typingIndicator": {
   "dots": 3,
   "keyframe": "typing-dot",
   "duration": "1s infinite",
   "delaysMs": [
    0,
    150,
    300
   ],
   "body": "0%,60%,100%{opacity:.25;transform:none} 30%{opacity:.9;transform:translateY(-3px)}",
   "container": "display:none por padrão; só aparece no estado typing; height fixa 20px (sem layout shift)"
  },
  "headlineTypewriter": {
   "mechanism": "palavra a palavra via JS (data-typing=true no cursor)",
   "caret": "2px×.9em, blink 1.06s step-end infinite; durante digitação animation:none;opacity:1 (caret sólido)",
   "cadence": "rajadas ~230-450ms, pausa ~1.8s entre palavras",
   "reducedMotion": "caret display:none; texto final direto (sr-only guarda o texto completo)"
  }
 },
 "reveals": {
  "scrollDriven": {
   "supported": "@supports (animation-timeline: view())",
   "rule": "animation: reveal linear both; animation-timeline: view(); animation-range: entry 0 entry 45%",
   "variants": {
    "reveal": "translate3d(0,28px,0)+opacity 0→1",
