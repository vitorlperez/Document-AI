# Public domain and certificate contact
APP_DOMAIN=app.example.com
CADDY_EMAIL=ops@example.com

# Database and AI
# This value is embedded in DATABASE_URL: use URL-safe hexadecimal only.
# Generate it with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-64-hex-characters
OPENAI_API_KEY=replace-with-openai-server-key
TYPESAFE_API_KEY=replace-with-typesafe-key
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-stable-fernet-key

# Identity and OAuth callbacks are assembled from APP_DOMAIN by Compose.
WORKOS_API_KEY=replace-with-workos-api-key
WORKOS_CLIENT_ID=replace-with-workos-client-id
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret

# E-mail invitation delivery
RESEND_API_KEY=replace-with-resend-api-key
INVITATION_FROM_EMAIL=invite@example.com

# Billing (Stripe, ADR-0023). BILLING_PROVIDER=none keeps payment routes disabled (501).
BILLING_PROVIDER=none
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional; leave unset to use the pinned default in code.
# STRIPE_API_VERSION=
# Optional; leave unset to use the pinned default in code.
# STRIPE_CHECKOUT_INTEGRATION_ID=
# Catalog sync script only (backend/scripts/stripe_sync_catalog.py); not read by the API.
STRIPE_CATALOG_API_KEY=
# Optional; Customer Portal configuration (bpc_...) created by the catalog sync script. Unset = account default.
STRIPE_PORTAL_CONFIGURATION_ID=
# Pix Automático in Checkout (mandate options). Keep false until Pix is enabled on the Stripe account and verified.
STRIPE_PIX_ENABLED=false
