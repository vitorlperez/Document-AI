# Copy to .env.remote-worker. These values must match the API service in Render.
# Use the direct PostgreSQL connection URL from Supabase, including sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres.example:replace-password@db.example.supabase.co:5432/postgres?sslmode=require
# Use the TLS URL supplied by Upstash (normally rediss://...).
REDIS_URL=rediss://default:replace-password@example.upstash.io:6379/0

PUBLIC_APP_URL=https://app.example.com
OPENAI_API_KEY=replace-with-openai-server-key

WORKOS_API_KEY=replace-with-workos-api-key
WORKOS_CLIENT_ID=replace-with-workos-client-id
WORKOS_REDIRECT_URI=https://api.example.com/auth/callback

GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/data-sources/google/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-stable-fernet-key

MICROSOFT_OAUTH_CLIENT_ID=replace-with-microsoft-entra-client-id
MICROSOFT_OAUTH_CLIENT_SECRET=replace-with-microsoft-entra-client-secret
MICROSOFT_OAUTH_REDIRECT_URI=https://api.example.com/data-sources/onedrive/oauth/callback
MICROSOFT_TOKEN_ENCRYPTION_KEY=replace-with-stable-fernet-key

RESEND_API_KEY=replace-with-resend-api-key
INVITATION_FROM_EMAIL=invite@example.com
