# Public browser URL. The local Docker stack uses this default unless overridden.
PUBLIC_APP_URL=http://localhost:3000

# Optional integrations; the local stack works without these credentials.
OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=
RESEND_API_KEY=
INVITATION_FROM_EMAIL=
