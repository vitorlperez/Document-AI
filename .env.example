# Public browser URL. The local Docker stack uses this default unless overridden.
PUBLIC_APP_URL=http://localhost:3000

# Optional integrations; the local stack works without these credentials.
DATABASE_URL=postgresql+psycopg://document_intelligence:document_intelligence@localhost:5432/document_intelligence
REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=
# Intent decisions: jev (default; TypeSafe Jev, key at https://console.typesafe.ai) or llm (AGENT_PLANNER_MODEL).
# Without TYPESAFE_API_KEY the agent uses llm. AGENT_INTENT_ENGINE=llm forces it.
TYPESAFE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Robot Drive is opt-in. Use a separate Fernet key; IAM credentials stay offline.
GOOGLE_DRIVE_SA_ENABLED=false
GOOGLE_SA_KEY_ENCRYPTION_KEY=
GOOGLE_SA_KEY_ENCRYPTION_PREVIOUS_KEYS=
GOOGLE_SA_ALLOWED_ORGS=
GOOGLE_SA_DOWNLOAD_WORKERS=3
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=
MICROSOFT_SHAREPOINT_REDIRECT_URI=
MICROSOFT_TOKEN_ENCRYPTION_KEY=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
RESEND_API_KEY=
INVITATION_FROM_EMAIL=
# On-demand robots (one per organization). Pool projects are plain ids; the provisioner
# credential (base64 service-account JSON, least-privilege on the pool project only) is Worker-only.
GOOGLE_SA_POOL_PROJECTS=
GOOGLE_SA_PROJECT_QUOTA=100
GOOGLE_SA_WARM_POOL_SIZE=0
GOOGLE_SA_PROVISIONER_KEY_B64=

# Billing (Stripe, ADR-0023). BILLING_PROVIDER=none keeps payment routes disabled (501).
BILLING_PROVIDER=none
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional; leave unset to use the pinned default in code.
# STRIPE_API_VERSION=
# Optional; leave unset to use the pinned default in code.
# STRIPE_CHECKOUT_INTEGRATION_ID=
# Catalog sync script only (backend/scripts/stripe_sync_catalog.py); not read by the API.
STRIPE_CATALOG_API_KEY=
# Optional; Customer Portal configuration (bpc_...) created by the catalog sync script. Unset = account default.
STRIPE_PORTAL_CONFIGURATION_ID=
# Pix Automático in Checkout (mandate options). Keep false until Pix is enabled on the Stripe account and verified.
STRIPE_PIX_ENABLED=false
